# Copy this file to .env.local and adjust if your backend runs elsewhere.
# Public at build time — never put secrets here.
VITE_API_BASE_URL=http://localhost:8082/api
VITE_GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id.apps.googleusercontent.com

# Local development only: run the separate admin control panel (its own site) instead of the member app.
# In production this is selected automatically by the hostname (admin.<domain>), so leave it unset there.
# VITE_APP_MODE=admin
